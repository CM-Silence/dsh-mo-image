{
  "name": "dsh-mo-image",
  "version": "0.4.1",
  "description": "DSH plugin: generate and edit images with model-aware prompt guidance over an OpenAI-compatible image model",
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "test": "node --test",
    "build:locales": "node scripts/build-locales.mjs",
    "check:locales": "node scripts/build-locales.mjs --check",
    "release": "node scripts/release.mjs"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale",
    "scripts",
    "skills",
    "cordis.patch.yml",
    "CHANGELOG.md",
    "THIRD-PARTY-NOTICES.md",
    "README.md"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CM-Silence/dsh-mo-image.git"
  },
  "homepage": "https://github.com/CM-Silence/dsh-mo-image#readme",
  "bugs": {
    "url": "https://github.com/CM-Silence/dsh-mo-image/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "image",
    "openai-images"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings-general",
        "@deepseek-ai/dsh-client-ui-settings-models",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "license": "MIT"
}
